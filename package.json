{
  "name": "fita-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://fitaread.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/urimarti2610/fita.git"
  },
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "e2e": "pnpm -r e2e",
    "dev:web": "pnpm --filter @fita/core build && pnpm --filter @fita/web dev",
    "build:web": "pnpm --filter \"@fita/web...\" build",
    "preview:web": "pnpm --filter \"@fita/web...\" build && pnpm --filter @fita/web preview",
    "test:web": "pnpm --filter @fita/web test",
    "e2e:web": "pnpm --filter \"@fita/web...\" build && pnpm --filter @fita/web e2e",
    "build:extension": "pnpm --filter \"@fita/extension...\" build",
    "test:extension": "pnpm --filter @fita/extension test",
    "e2e:extension": "pnpm --filter \"@fita/extension...\" build && pnpm --filter @fita/extension e2e",
    "build:core": "pnpm --filter @fita/core build",
    "test:core": "pnpm --filter @fita/core test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2"
  }
}
