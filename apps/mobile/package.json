{
  "name": "@fita/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "vite build --mode native",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "sync": "vite build --mode native && cap sync",
    "android": "vite build --mode native && cap sync android && cap open android",
    "ios": "vite build --mode native && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.2",
    "@fita/core": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "happy-dom": "21.0.4",
    "jszip": "3.10.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
