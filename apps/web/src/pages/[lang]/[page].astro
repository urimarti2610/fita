---
import Converter from "../../components/Converter.astro";
import Uses from "../../components/Uses.astro";
import { LANGS, type Lang, PAGES, type PageKey, SLUGS, STRINGS } from "../../i18n";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    PAGES.map((key) => ({ params: { lang, page: SLUGS[lang][key] }, props: { key } })),
  );
}

type Props = { key: PageKey };
const lang = Astro.params.lang as Lang;
const { key } = Astro.props;
const t = STRINGS[lang];
---

{
  key === "convert" ? (
    <Base lang={lang} title={t.convert.title} page={key}>
      <article class="wrap">
        <div class="prose">
          <h1>{t.convert.title}</h1>
          <p class="first">{t.convert.intro}</p>
        </div>
        <div class="tool">
          <Converter lang={lang} />
        </div>
        <section class="prose devices" aria-labelledby="devices-title">
          <h2 id="devices-title">{t.convert.devices.heading}</h2>
          <dl>
            {t.convert.devices.items.map((d) => (
              <>
                <dt>{d.name}</dt>
                <dd>{d.text}</dd>
              </>
            ))}
          </dl>
          <p>{t.convert.devices.calibre}</p>
        </section>
      </article>
    </Base>
  ) : key === "uses" ? (
    <Base lang={lang} title={t.uses.title} page={key}>
      <article class="wrap">
        <div class="prose">
          <h1>{t.uses.title}</h1>
          <p class="first">{t.uses.intro}</p>
        </div>
        <Uses lang={lang} />
      </article>
    </Base>
  ) : (
    <Base lang={lang} title={t.pages[key].title} page={key}>
      <article class="wrap">
        <div class="prose">
          <h1>{t.pages[key].title}</h1>
          {t.pages[key].body.map((p, i) => <p class={i === 0 ? "first" : undefined}>{p}</p>)}
        </div>
      </article>
    </Base>
  )
}

<style>
  article {
    padding-top: clamp(3rem, 8vw, 5rem);
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
  }
  .first {
    font-size: var(--step-1);
  }
  .tool {
    margin-top: 3rem;
  }
  .devices {
    margin-top: var(--section);
  }
  dl {
    margin: 1.5rem 0 0;
  }
  dt {
    font-weight: 700;
    margin-top: 1.25rem;
  }
  dd {
    margin: 0.25rem 0 0;
  }
</style>
