---
// The site lives under /<lang>/. Pick the visitor's language when possible.
import { WEB_BRAND } from "../../brand";
import { href, LANG_NAMES, LANGS } from "../i18n";
const fallback = href("es");
const targets = Object.fromEntries(LANGS.map((l) => [l, href(l)]));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{WEB_BRAND.name}</title>
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fallback} />
    <script is:inline define:vars={{ targets, fallback }}>
      const lang = (navigator.languages || [navigator.language])
        .map((l) => l.slice(0, 2).toLowerCase())
        .find((l) => l in targets);
      location.replace(lang ? targets[lang] : fallback);
    </script>
  </head>
  <body>
    <ul>{LANGS.map((l) => <li><a href={targets[l]} lang={l}>{LANG_NAMES[l]}</a></li>)}</ul>
  </body>
</html>
