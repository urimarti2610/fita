---
// Strength, style and "every" controls shared by the demo and the converter.
// Render inside a <form>: values are read with FormData by name.
import { DEFAULT_OPTIONS, DEFAULT_STYLE, EMPHASIS_STYLES } from "@fita/core";
import { type Lang, STRINGS } from "../i18n";

type Props = { lang: Lang; id: string; layout: "extended" | "compact" };
const { lang, id, layout } = Astro.props;
const t = STRINGS[lang].demo;
---

<div class="emphasis-controls">
  <div class="control">
    <label for={`${id}-strength`}>{t.strength} <output id={`${id}-strength-value`} for={`${id}-strength`}>{Math.round(DEFAULT_OPTIONS.strength * 100)} %</output></label>
    <input id={`${id}-strength`} name="strength" type="range" min="0.2" max="0.7" step="0.05" value={DEFAULT_OPTIONS.strength} />
  </div>
  <fieldset class="control styles">
    <legend>{t.style}</legend>
    {EMPHASIS_STYLES.map((style) => (
      <label>
        <input type="radio" name="style" value={style} checked={style === DEFAULT_STYLE} />
        <span>{t.styles[style]}</span>
      </label>
    ))}
  </fieldset>
  {layout === "compact" ? (
    <div class="control">
      <label for={`${id}-every`}>{t.every}</label>
      <select id={`${id}-every`} name="every">
        {t.everyOptions.map((label, i) => <option value={i + 1}>{label}</option>)}
      </select>
    </div>
  ) : (
    <details class="control more">
      <summary>{t.more}</summary>
      <div class="more-grid">
        <label>
          {t.every}
          <select name="every">
            {t.everyOptions.map((label, i) => <option value={i + 1}>{label}</option>)}
          </select>
        </label>
        <label>
          {t.lineHeight}
          <select name="lineHeight">
            <option value="">{t.pageDefault}</option>
            <option value="1.8">1.8</option>
            <option value="2">2.0</option>
            <option value="2.2">2.2</option>
          </select>
        </label>
        <label>
          {t.maxWidth}
          <select name="maxWidth">
            <option value="">{t.pageDefault}</option>
            {[50, 65, 80].map((w, i) => <option value={`${w}ch`}>{t.widths[i]}</option>)}
          </select>
        </label>
      </div>
    </details>
  )}
</div>

<script>
  // Every group of controls on the page (demo, worksheets, converter, settings bubble)
  // shares one stored state: changes here are saved and mirrored everywhere else.
  import {
    loadSettings,
    type ReadingSettings,
    SETTINGS_EVENT,
    saveSettings,
  } from "../settings/store";

  for (const group of document.querySelectorAll<HTMLElement>(".emphasis-controls")) {
    const strength = group.querySelector<HTMLInputElement>('input[name="strength"]');
    const output = group.querySelector<HTMLOutputElement>("output");
    const every = group.querySelector<HTMLSelectElement>('select[name="every"]');
    const styles = [...group.querySelectorAll<HTMLInputElement>('input[name="style"]')];
    let applying = false;

    const readout = () => {
      if (strength && output) output.textContent = `${Math.round(Number(strength.value) * 100)} %`;
    };

    const read = (): ReadingSettings => ({
      strength: Number(strength?.value),
      every: Number(every?.value ?? 1),
      style: (styles.find((s) => s.checked)?.value ?? "bold-fade") as ReadingSettings["style"],
    });

    /** Shows `settings` and lets the host tool re-render, without saving them back. */
    function apply(settings: ReadingSettings) {
      applying = true;
      if (strength) strength.value = String(settings.strength);
      if (every) every.value = String(settings.every);
      for (const s of styles) s.checked = s.value === settings.style;
      readout();
      strength?.dispatchEvent(new Event("input", { bubbles: true }));
      strength?.dispatchEvent(new Event("change", { bubbles: true }));
      applying = false;
    }

    const store = () => {
      readout();
      if (!applying) saveSettings(read(), group);
    };
    group.addEventListener("input", store);
    group.addEventListener("change", store);
    window.addEventListener(SETTINGS_EVENT, (event) => {
      const { settings, source } = (event as CustomEvent).detail;
      if (source !== group) apply(settings);
    });
    apply(loadSettings());
  }
</script>

<style>
  .emphasis-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1.5rem 2.5rem;
  }
  .control {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  label,
  legend,
  summary {
    font-weight: 700;
  }
  output {
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: min(16rem, 100%);
    accent-color: var(--brand);
  }
  .styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .styles legend {
    margin-bottom: 0.5rem;
  }
  .styles label {
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .styles label:has(input:checked) {
    border-color: var(--brand);
    background: var(--brand-soft);
  }
  .styles input {
    accent-color: var(--brand);
    margin: 0;
  }
  .more summary {
    cursor: pointer;
    padding-block: 0.2rem;
  }
  .more-grid {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .more-grid label {
    display: grid;
    gap: 0.35rem;
  }
  select {
    font: inherit;
    font-weight: 400;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }
</style>
