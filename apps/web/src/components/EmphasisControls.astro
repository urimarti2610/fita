---
// Strength, style and "every" controls shared by the demo and the converter.
// Render inside a <form>: values are read with FormData by name.
import { DEFAULT_OPTIONS, DEFAULT_STYLE, EMPHASIS_STYLES } from "@fita/core";
import { type Lang, STRINGS } from "../i18n";

type Props = { lang: Lang; id: string; layout: "extended" | "compact" };
const { lang, id, layout } = Astro.props;
const t = STRINGS[lang].demo;
---

<div class="emphasis-controls">
  <div class="control">
    <label for={`${id}-strength`}>{t.strength} <output id={`${id}-strength-value`} for={`${id}-strength`}>{Math.round(DEFAULT_OPTIONS.strength * 100)} %</output></label>
    <input id={`${id}-strength`} name="strength" type="range" min="0.2" max="0.7" step="0.05" value={DEFAULT_OPTIONS.strength} />
  </div>
  <fieldset class="control styles">
    <legend>{t.style}</legend>
    {EMPHASIS_STYLES.map((style) => (
      <label>
        <input type="radio" name="style" value={style} checked={style === DEFAULT_STYLE} />
        <span>{t.styles[style]}</span>
      </label>
    ))}
  </fieldset>
  {layout === "compact" ? (
    <div class="control">
      <label for={`${id}-every`}>{t.every}</label>
      <select id={`${id}-every`} name="every">
        {t.everyOptions.map((label, i) => <option value={i + 1}>{label}</option>)}
      </select>
    </div>
  ) : (
    <details class="control more">
      <summary>{t.more}</summary>
      <div class="more-grid">
        <label>
          {t.every}
          <select name="every">
            {t.everyOptions.map((label, i) => <option value={i + 1}>{label}</option>)}
          </select>
        </label>
        <label>
          {t.lineHeight}
          <select name="lineHeight">
            <option value="">{t.pageDefault}</option>
            <option value="1.8">1.8</option>
            <option value="2">2.0</option>
            <option value="2.2">2.2</option>
          </select>
        </label>
        <label>
          {t.maxWidth}
          <select name="maxWidth">
            <option value="">{t.pageDefault}</option>
            {[50, 65, 80].map((w, i) => <option value={`${w}ch`}>{t.widths[i]}</option>)}
          </select>
        </label>
      </div>
    </details>
  )}
</div>

<script>
  // Keeps every strength readout in sync with its slider.
  for (const output of document.querySelectorAll<HTMLOutputElement>(".emphasis-controls output")) {
    const input = document.getElementById(output.htmlFor.value) as HTMLInputElement | null;
    const sync = () => {
      if (input) output.textContent = `${Math.round(Number(input.value) * 100)} %`;
    };
    input?.addEventListener("input", sync);
    sync();
  }
</script>

<style>
  .emphasis-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1.5rem 2.5rem;
  }
  .control {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  label,
  legend,
  summary {
    font-weight: 700;
  }
  output {
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: min(16rem, 100%);
    accent-color: var(--forest);
  }
  .styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .styles legend {
    margin-bottom: 0.5rem;
  }
  .styles label {
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .styles label:has(input:checked) {
    border-color: var(--forest);
    background: var(--moss);
  }
  .styles input {
    accent-color: var(--forest);
    margin: 0;
  }
  .more summary {
    cursor: pointer;
    padding-block: 0.2rem;
  }
  .more-grid {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .more-grid label {
    display: grid;
    gap: 0.35rem;
  }
  select {
    font: inherit;
    font-weight: 400;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }
</style>
