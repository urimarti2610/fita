---
import { type Lang, STRINGS } from "../i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = STRINGS[lang].uses;
---

<div class="uses">
  {t.cases.map((c) => (
    <section id={c.id} aria-labelledby={`${c.id}-title`}>
      <h2 id={`${c.id}-title`}>{c.title}</h2>
      <p class="lede">{c.lede}</p>
      <div class="columns">
        <div>
          <h3>{t.how}</h3>
          <ul>{c.steps.map((s) => <li>{s}</li>)}</ul>
        </div>
        <div class="care">
          <h3>{t.care}</h3>
          <ul>{c.notes.map((n) => <li>{n}</li>)}</ul>
        </div>
      </div>
    </section>
  ))}
</div>

<style>
  .uses {
    margin-top: 3rem;
  }
  section {
    padding-block: 3rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }
  h2 {
    font-size: var(--step-2);
  }
  .lede {
    margin-top: 1rem;
    font-size: var(--step-1);
    max-width: 44ch;
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 2rem 3.5rem;
    margin-top: 2rem;
  }
  h3 {
    font-size: var(--step-0);
    margin-bottom: 0.75rem;
  }
  ul {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.75rem;
  }
  li::marker {
    color: var(--forest);
  }
  .care {
    color: var(--muted);
  }
  .care h3 {
    color: var(--ink);
  }
</style>
