---
import { type Lang, STRINGS } from "../i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = STRINGS[lang].uses;

/** Line icons, in the order of the cases: education, professionals, adults. */
const ICONS = [
  // Open book on a desk.
  '<path d="M4 6.5C6.5 5 9 5 12 6.5c3-1.5 5.5-1.5 8 0V18c-2.5-1.5-5-1.5-8 0-3-1.5-5.5-1.5-8 0Z"/><path d="M12 6.5V18"/>',
  // Speech bubble with a voice wave.
  '<path d="M5 5h14a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1h-7l-4 3v-3H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/><path d="M9 9.5v2M12 8v5M15 9.5v2"/>',
  // A person reading, with a lamp.
  '<circle cx="12" cy="7" r="3"/><path d="M5.5 20c.6-3.6 3.2-6 6.5-6s5.9 2.4 6.5 6"/>',
];
const icon = (i: number) =>
  `<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[i] ?? ""}</svg>`;
---

<div class="uses" id="uses">
  <nav class="picker" aria-label={t.title}>
    {t.cases.map((c, i) => (
      <a class="choice" href={`#${c.id}`} id={`${c.id}-tab`} data-case={c.id}>
        <span class="choice-icon" set:html={icon(i)} />
        <span class="choice-title">{c.title}</span>
        <span class="choice-summary">{c.summary}</span>
      </a>
    ))}
  </nav>

  {t.cases.map((c, i) => (
    <section class="panel" id={c.id} aria-labelledby={`${c.id}-title`}>
      <header class="panel-head">
        <span class="panel-icon" set:html={icon(i)} />
        <div>
          <h2 id={`${c.id}-title`}>{c.title}</h2>
          <p class="lede">{c.lede}</p>
        </div>
      </header>
      <div class="columns">
        <div>
          <h3>{t.how}</h3>
          <ul class="steps">{c.steps.map((s) => <li>{s}</li>)}</ul>
        </div>
        <aside class="care" aria-label={t.care}>
          <h3>{t.care}</h3>
          <ul>{c.notes.map((n) => <li>{n}</li>)}</ul>
        </aside>
      </div>
    </section>
  ))}
</div>

<script>
  // Progressive enhancement: without JavaScript the cases read one after another and
  // the cards are links. With it, the cards become tabs (WAI-ARIA tabs pattern), and
  // links such as #logopedia from other pages open their own tab.
  const root = document.getElementById("uses");
  const tabs = [...(root?.querySelectorAll<HTMLAnchorElement>(".choice") ?? [])];
  const panels = tabs.map((tab) => document.getElementById(tab.dataset.case ?? "") as HTMLElement);

  if (root && tabs.length && panels.every(Boolean)) {
    const list = root.querySelector(".picker") as HTMLElement;
    list.setAttribute("role", "tablist");
    root.classList.add("tabbed");
    tabs.forEach((tab, i) => {
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panels[i]?.id ?? "");
      panels[i]?.setAttribute("role", "tabpanel");
      panels[i]?.setAttribute("aria-labelledby", tab.id);
    });

    const select = (index: number, focus = false, updateHash = true) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (panels[i]) panels[i].hidden = !selected;
      });
      if (focus) tabs[index]?.focus();
      const id = tabs[index]?.dataset.case;
      if (updateHash && id) history.replaceState(null, "", `#${id}`);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", (event) => {
        event.preventDefault();
        select(i);
      });
      tab.addEventListener("keydown", (event) => {
        const next = {
          ArrowRight: (i + 1) % tabs.length,
          ArrowDown: (i + 1) % tabs.length,
          ArrowLeft: (i - 1 + tabs.length) % tabs.length,
          ArrowUp: (i - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        }[event.key];
        if (next !== undefined) {
          event.preventDefault();
          select(next, true);
        }
      });
    });

    const fromHash = () => {
      const index = tabs.findIndex((tab) => `#${tab.dataset.case}` === location.hash);
      return index >= 0 ? index : 0;
    };
    select(fromHash(), false, false);
    window.addEventListener("hashchange", () => select(fromHash(), false, false));
  }
</script>

<style>
  .uses {
    margin-top: 3rem;
    display: grid;
    gap: 2rem;
  }
  .picker {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .choice {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.25rem 1.25rem 1.4rem;
    border: 1.5px solid var(--line);
    border-radius: 18px;
    color: var(--ink);
    text-decoration: none;
    background: var(--paper);
    transition:
      border-color 0.15s,
      background-color 0.15s;
  }
  .choice:hover {
    border-color: var(--brand);
  }
  .choice[aria-selected="true"] {
    border-color: var(--brand);
    background: var(--brand-soft);
    box-shadow: inset 0 0 0 1.5px var(--brand);
  }
  .choice-icon,
  .panel-icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: var(--brand-soft);
    color: var(--brand);
  }
  .choice[aria-selected="true"] .choice-icon {
    background: var(--brand);
    color: var(--on-brand);
  }
  .choice-title {
    margin-top: 0.4rem;
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .choice-summary {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .panel {
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 24px;
    background: var(--band);
    scroll-margin-top: 1rem;
  }
  /* Without JavaScript every case shows; give them room between each other. */
  .uses:not(.tabbed) .panel + .panel {
    margin-top: 1rem;
  }
  .panel[hidden] {
    display: none;
  }
  .panel-head {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .panel-head .panel-icon {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--brand);
    color: var(--on-brand);
  }
  h2 {
    font-size: var(--step-2);
  }
  .lede {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 48ch;
  }
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 2rem 3rem;
    margin-top: 2.25rem;
  }
  @media (max-width: 760px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel-head {
      flex-direction: column;
      gap: 1rem;
    }
  }
  h3 {
    font-size: var(--step-0);
    margin-bottom: 1rem;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }
  .steps li {
    position: relative;
    padding-left: 2.1rem;
  }
  /* A check in a brand circle, drawn in the theme's on-brand colour (legible in both themes). */
  .steps li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.2em;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--brand);
  }
  .steps li::after {
    content: "";
    position: absolute;
    left: 0.46rem;
    top: calc(0.2em + 0.3rem);
    width: 0.38rem;
    height: 0.62rem;
    border: solid var(--on-brand);
    border-width: 0 2.5px 2.5px 0;
    transform: rotate(45deg);
  }
  .care {
    align-self: start;
    padding: 1.4rem 1.5rem;
    border-radius: 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .care h3 {
    color: var(--ink);
  }
  .care li {
    position: relative;
    padding-left: 1.1rem;
  }
  .care li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--gold);
  }
  @media (prefers-reduced-motion: reduce) {
    .choice {
      transition: none;
    }
  }
</style>
