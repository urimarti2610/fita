---
import { EMPHASIS_STYLES, toHTML } from "@fita/core";
import type { Lang } from "../i18n";
import { STRINGS } from "../i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = STRINGS[lang].demo;
// Server-rendered first result, so the demo reads correctly before (or without) JavaScript.
const initial = `<fita-w>${toHTML(t.sample, { locale: lang }, "fita-e")}</fita-w>`;
---

<section class="demo wrap" aria-labelledby="demo-title">
  <h2 id="demo-title">{t.heading}</h2>
  <p class="intro">{t.intro}</p>

  <div class="panes">
    <div class="pane">
      <label for="demo-input">{t.input}</label>
      <textarea id="demo-input" lang={lang} rows="9" spellcheck="false">{t.sample}</textarea>
    </div>
    <div class="pane">
      <span id="demo-output-label" class="label">{t.output}</span>
      <div
        id="demo-output"
        class="output"
        lang={lang}
        role="region"
        aria-labelledby="demo-output-label"
        aria-live="off"
        tabindex="0"
        data-fita-style="bold"
        set:html={initial}
      />
    </div>
  </div>

  <form class="controls" id="demo-controls" aria-label={t.heading}>
    <div class="control">
      <label for="demo-strength">{t.strength} <output id="demo-strength-value" for="demo-strength">40 %</output></label>
      <input id="demo-strength" name="strength" type="range" min="0.2" max="0.7" step="0.05" value="0.4" />
    </div>
    <fieldset class="control styles">
      <legend>{t.style}</legend>
      {EMPHASIS_STYLES.map((style) => (
        <label>
          <input type="radio" name="style" value={style} checked={style === "bold"} />
          <span>{t.styles[style]}</span>
        </label>
      ))}
    </fieldset>
    <details class="control more">
      <summary>{t.more}</summary>
      <div class="more-grid">
        <label>
          {t.every}
          <select name="every">
            {t.everyOptions.map((label, i) => <option value={i + 1}>{label}</option>)}
          </select>
        </label>
        <label>
          {t.lineHeight}
          <select name="lineHeight">
            <option value="">{t.pageDefault}</option>
            <option value="1.8">1.8</option>
            <option value="2">2.0</option>
            <option value="2.2">2.2</option>
          </select>
        </label>
        <label>
          {t.maxWidth}
          <select name="maxWidth">
            <option value="">{t.pageDefault}</option>
            {[50, 65, 80].map((w, i) => <option value={`${w}ch`}>{t.widths[i]}</option>)}
          </select>
        </label>
      </div>
    </details>
  </form>
</section>

<script>
  import { applyToElement, type Controller, STYLE_ATTRIBUTE } from "@fita/core";

  const input = document.getElementById("demo-input") as HTMLTextAreaElement;
  const output = document.getElementById("demo-output") as HTMLElement;
  const form = document.getElementById("demo-controls") as HTMLFormElement;
  const strengthValue = document.getElementById("demo-strength-value") as HTMLOutputElement;
  let controller: Controller | null = null;

  function options() {
    const data = new FormData(form);
    return { strength: Number(data.get("strength")), every: Number(data.get("every") ?? 1) };
  }

  function render() {
    controller?.stop();
    output.textContent = input.value;
    // Chunked, idle-time processing: any length, the page never freezes.
    controller = applyToElement(output, options(), { injectStyles: false, observe: false });
  }

  function restyle() {
    const data = new FormData(form);
    output.setAttribute(STYLE_ATTRIBUTE, String(data.get("style")));
    output.style.lineHeight = String(data.get("lineHeight") ?? "");
    output.style.maxWidth = String(data.get("maxWidth") ?? "");
    strengthValue.textContent = `${Math.round(Number(data.get("strength")) * 100)} %`;
  }

  let pending = 0;
  input.addEventListener("input", () => {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(render);
  });
  form.addEventListener("input", (event) => {
    restyle();
    const name = (event.target as HTMLInputElement).name;
    if (name === "strength" || name === "every") controller?.update(options());
  });
  form.addEventListener("submit", (event) => event.preventDefault());
  restyle();
  render();
</script>

<style>
  .demo {
    margin-top: var(--section);
  }
  .intro {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  .panes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .pane {
    display: grid;
    gap: 0.5rem;
    grid-template-rows: auto 1fr;
  }
  label,
  .label,
  legend,
  summary {
    font-weight: 700;
  }
  textarea,
  .output {
    width: 100%;
    min-height: 16rem;
    max-height: 32rem;
    overflow: auto;
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    font: inherit;
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--ink);
  }
  textarea {
    resize: vertical;
    background: transparent;
    border: 1.5px solid var(--line);
  }
  .output {
    background: var(--moss);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 1.5rem 2.5rem;
    margin-top: 1.5rem;
  }
  .control {
    border: 0;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .control output {
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  input[type="range"] {
    width: min(16rem, 100%);
    accent-color: var(--forest);
  }
  .styles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .styles legend {
    margin-bottom: 0.5rem;
  }
  .styles label {
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.8rem 0.35rem 0.55rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    cursor: pointer;
  }
  .styles label:has(input:checked) {
    border-color: var(--forest);
    background: var(--moss);
  }
  .styles input {
    accent-color: var(--forest);
    margin: 0;
  }
  .more summary {
    cursor: pointer;
    padding-block: 0.2rem;
  }
  .more-grid {
    display: grid;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .more-grid label {
    display: grid;
    gap: 0.35rem;
  }
  select {
    font: inherit;
    font-weight: 400;
    padding: 0.4rem 0.6rem;
    border-radius: 8px;
    border: 1.5px solid var(--line);
    background: var(--paper);
    color: var(--ink);
  }
</style>
