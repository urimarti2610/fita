---
import { DEFAULT_STYLE, toHTML } from "@fita/core";
import EmphasisControls from "./EmphasisControls.astro";
import type { Lang } from "../i18n";
import { STRINGS } from "../i18n";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = STRINGS[lang].demo;
// Server-rendered first result, so the demo reads correctly before (or without) JavaScript.
const initial = `<fita-w>${toHTML(t.sample, { locale: lang }, "fita-e")}</fita-w>`;
---

<section class="demo wrap" aria-labelledby="demo-title">
  <h2 id="demo-title">{t.heading}</h2>
  <p class="intro">{t.intro}</p>

  <div class="panes">
    <div class="pane">
      <label for="demo-input">{t.input}</label>
      <textarea id="demo-input" lang={lang} rows="9" spellcheck="false">{t.sample}</textarea>
    </div>
    <div class="pane">
      <span id="demo-output-label" class="label">{t.output}</span>
      <div
        id="demo-output"
        class="output"
        lang={lang}
        role="region"
        aria-labelledby="demo-output-label"
        aria-live="off"
        tabindex="0"
        data-fita-style={DEFAULT_STYLE}
        set:html={initial}
      />
    </div>
  </div>

  <form class="controls" id="demo-controls" aria-label={t.heading}>
    <EmphasisControls lang={lang} id="demo" layout="extended" />
  </form>
</section>

<script>
  import { applyToElement, type Controller, STYLE_ATTRIBUTE } from "@fita/core";

  const input = document.getElementById("demo-input") as HTMLTextAreaElement;
  const output = document.getElementById("demo-output") as HTMLElement;
  const form = document.getElementById("demo-controls") as HTMLFormElement;
  let controller: Controller | null = null;

  function options() {
    const data = new FormData(form);
    return { strength: Number(data.get("strength")), every: Number(data.get("every") ?? 1) };
  }

  function render() {
    controller?.stop();
    output.textContent = input.value;
    // Chunked, idle-time processing: any length, the page never freezes.
    controller = applyToElement(output, options(), { injectStyles: false, observe: false });
  }

  function restyle() {
    const data = new FormData(form);
    output.setAttribute(STYLE_ATTRIBUTE, String(data.get("style")));
    output.style.lineHeight = String(data.get("lineHeight") ?? "");
    output.style.maxWidth = String(data.get("maxWidth") ?? "");
  }

  let pending = 0;
  input.addEventListener("input", () => {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(render);
  });
  form.addEventListener("input", (event) => {
    restyle();
    const name = (event.target as HTMLInputElement).name;
    if (name === "strength" || name === "every") controller?.update(options());
  });
  form.addEventListener("submit", (event) => event.preventDefault());
  restyle();
  render();
</script>

<style>
  .demo {
    margin-top: var(--section);
  }
  .intro {
    margin-top: 0.5rem;
    color: var(--muted);
    max-width: var(--measure);
  }
  .panes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .pane {
    display: grid;
    gap: 0.5rem;
    grid-template-rows: auto 1fr;
  }
  label,
  .label {
    font-weight: 700;
  }
  textarea,
  .output {
    width: 100%;
    min-height: 16rem;
    max-height: 32rem;
    overflow: auto;
    padding: 1.1rem 1.25rem;
    border-radius: 14px;
    font: inherit;
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--ink);
  }
  textarea {
    resize: vertical;
    background: transparent;
    border: 1.5px solid var(--line);
  }
  .output {
    background: var(--moss);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .controls {
    margin-top: 1.5rem;
  }
</style>
