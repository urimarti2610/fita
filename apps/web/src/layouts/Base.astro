---
import { EMPHASIS_CSS } from "@fita/core";
import { WEB_BRAND } from "../../brand";
import { href, LANG_NAMES, LANGS, type Lang, type PageKey, STRINGS } from "../i18n";
import SettingsBubble from "../components/SettingsBubble.astro";
import "../styles/global.css";

type Props = { lang: Lang; title?: string; page?: PageKey };
const { lang, title, page } = Astro.props;
// The reading-settings bubble only where there are tools to apply it to.
const showSettings = page === undefined || page === "worksheets" || page === "convert";
const t = STRINGS[lang];
const fullTitle = title ? `${title} | ${WEB_BRAND.name}` : `${WEB_BRAND.name}: ${t.hero.headline}`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(href(l, page), Astro.site)} />)}
    <meta name="theme-color" content="#f6f7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131a1b" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply the visitor's saved theme before first paint, so there is no flash.
      try {
        const theme = localStorage.getItem("fita-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
    <style is:inline set:html={EMPHASIS_CSS}></style>
  </head>
  <body>
    <a class="skip no-print" href="#main">{t.nav.skip}</a>
    <header class="wrap site-header no-print">
      <a class="logo" href={href(lang)} aria-label={`${WEB_BRAND.name}, ${t.nav.home}`}>
        <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="currentColor"></rect>
          <rect x="6.4" y="9.6" width="7.7" height="4.5" fill="var(--paper)"></rect>
          <rect x="14" y="10.9" width="11.5" height="1.9" fill="var(--paper)"></rect>
          <rect x="6.4" y="17.9" width="5.8" height="4.5" fill="var(--paper)"></rect>
          <rect x="12" y="19.2" width="9" height="1.9" fill="var(--paper)"></rect>
        </svg>
        <span>{WEB_BRAND.name}</span>
      </a>
      <nav>
        <ul>
          <li><a href={href(lang, "uses")} aria-current={page === "uses" ? "page" : undefined}>{t.uses.title}</a></li>
          <li><a href={href(lang, "worksheets")} aria-current={page === "worksheets" ? "page" : undefined}>{t.worksheets.nav}</a></li>
          <li><a href={href(lang, "convert")} aria-current={page === "convert" ? "page" : undefined}>{t.nav.convert}</a></li>
          <li>
            <button
              type="button"
              class="theme-toggle"
              id="theme-toggle"
              hidden
              data-label={t.nav.theme.label}
              data-light={t.nav.theme.light}
              data-dark={t.nav.theme.dark}
            >
              <svg class="icon-light" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
                <path
                  d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"></path>
              </svg>
              <svg class="icon-dark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z" fill="currentColor"></path>
              </svg>
            </button>
          </li>
          <li>
            <details class="lang-menu">
              <summary aria-label={`${t.nav.language}: ${LANG_NAMES[lang]}`}>
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
                  <path
                    d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"></path>
                </svg>
                <span aria-hidden="true">{lang.toUpperCase()}</span>
                <svg class="chevron" viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
                  <path d="M2 4.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
              </summary>
              <ul>
                {LANGS.map((l) => (
                  <li>
                    <a href={href(l, page)} lang={l} hreflang={l} aria-current={l === lang ? "true" : undefined}>
                      {LANG_NAMES[l]}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="wrap site-footer no-print">
      <p>{t.footer.license}</p>
      <ul>
        <li><a href={href(lang, "privacy")}>{t.nav.privacy}</a></li>
        <li><a href={href(lang, "accessibility")}>{t.nav.accessibility}</a></li>
        <li><a href={WEB_BRAND.repository}>{t.nav.github}</a></li>
      </ul>
    </footer>
    {showSettings && <SettingsBubble lang={lang} />}
  </body>
</html>

<script>
  // Theme toggle: every click flips what is on screen. Until the visitor picks one the
  // page follows the system; picking the system's own theme goes back to following it.
  // Stored only in this browser.
  type Theme = "light" | "dark";
  const KEY = "fita-theme";
  const button = document.getElementById("theme-toggle") as HTMLButtonElement;
  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");

  function shown(): Theme {
    const chosen = root.dataset.theme;
    if (chosen === "light" || chosen === "dark") return chosen;
    return system.matches ? "dark" : "light";
  }

  function show() {
    const theme = shown();
    button.dataset.state = theme;
    button.setAttribute("aria-label", `${button.dataset.label}: ${button.dataset[theme]}`);
    button.title = button.getAttribute("aria-label") ?? "";
  }

  button.addEventListener("click", () => {
    const next: Theme = shown() === "dark" ? "light" : "dark";
    const followsSystem = next === (system.matches ? "dark" : "light");
    if (followsSystem) delete root.dataset.theme;
    else root.dataset.theme = next;
    try {
      if (followsSystem) localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
    } catch {
      // Storage blocked: the choice still applies to this page.
    }
    show();
  });
  system.addEventListener("change", show);
  show();
  button.hidden = false;

  // Language menu: native <details>; also close it on Escape or a click elsewhere.
  const langMenu = document.querySelector<HTMLDetailsElement>(".lang-menu");
  if (langMenu) {
    document.addEventListener("click", (event) => {
      if (langMenu.open && !langMenu.contains(event.target as Node)) langMenu.open = false;
    });
    langMenu.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && langMenu.open) {
        langMenu.open = false;
        langMenu.querySelector("summary")?.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.25rem;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-weight: 800;
    font-size: var(--step-1);
    text-decoration: none;
    color: var(--forest);
  }
  .logo span {
    color: var(--ink);
  }
  nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem 1.5rem;
    flex-wrap: wrap;
  }
  nav > ul > li > a {
    position: relative;
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--muted);
    text-decoration: none;
  }
  nav > ul > li > a:hover {
    color: var(--ink);
  }
  /* Current page: a short bar under the start of the word, like the emphasis itself. */
  nav > ul > li > a[aria-current="page"] {
    color: var(--ink);
    font-weight: 700;
  }
  nav > ul > li > a[aria-current="page"]::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 1.4em;
    height: 3px;
    border-radius: 2px;
    background: var(--forest);
  }
  /* Settings sit apart from the page links. */
  nav > ul > li:has(.theme-toggle) {
    margin-left: 0.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  nav > ul > li:has(.theme-toggle[hidden]) {
    display: none;
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    border-color: var(--forest);
  }
  .theme-toggle svg {
    display: none;
  }
  .theme-toggle[data-state="light"] .icon-light,
  .theme-toggle[data-state="dark"] .icon-dark {
    display: block;
  }
  .lang-menu {
    position: relative;
  }
  .lang-menu summary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.5rem;
    padding-inline: 0.8rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  .lang-menu summary::-webkit-details-marker {
    display: none;
  }
  .lang-menu summary:hover,
  .lang-menu[open] summary {
    border-color: var(--forest);
  }
  .lang-menu .chevron {
    transition: transform 0.15s;
  }
  .lang-menu[open] .chevron {
    transform: rotate(180deg);
  }
  .lang-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    min-width: 10rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: 12px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.12);
  }
  .lang-menu a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
  }
  .lang-menu a:hover {
    background: var(--moss);
    color: var(--ink);
  }
  .lang-menu a[aria-current] {
    font-weight: 700;
    color: var(--forest);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 3rem 2.5rem;
    margin-top: var(--section);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--1);
  }
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
</style>
